{
  "userName": "",
  "paths": {
    "projects": "/path/to/projects",
    "extra": "/path/to/projects/_EXTRA",
    "daily": "/path/to/projects/_EXTRA/daily",
    "scripts": "/path/to/projects/zscripts",
    "ignoreDirs": [
      "daily"
    ]
  },
  "compose": {
    "main": "/path/to/projects/docker-compose.yml",
    "minio": "/path/to/projects/file-manager/docker.compose.minio.yml"
  },
  "mongo": {
    "container": "mongo-db",
    "deniedDbs": [
      "admin",
      "config",
      "local"
    ],
    "superadmin": {
      "email": "e-sueldos@gmail.com",
      "db": "node-ts-boilerplate"
    }
  },
  "remoteBackup": {
    "script": "backup_improved4.sh",
    "types": [
      "incidencia",
      "legajo",
      "cursos",
      "documentos",
      "recibos",
      "notificaciones",
      "firma",
      "control-horario",
      "proyecto",
      "e-panel",
      "node-ts-boilerplate"
    ]
  },
  "session": {
    "enabled": true,
    "securityEnv": "",
    "jwtKey": "JWT_SECRET",
    "db": "node-ts-boilerplate",
    "frontUrl": "http://localhost:4200",
    "accessTtlSec": 3600,
    "refreshTtlSec": 86400
  },
  "redmine": {
    "enabled": true,
    "configFile": "",
    "baseUrl": "",
    "doneStatuses": [
      "Revisión",
      "Testeado",
      "Testing Consultoría",
      "Testing Aprobado Consultoría",
      "Terminado",
      "Entregado"
    ]
  },
  "gitlab": {
    "enabled": true,
    "baseUrl": "https://git.icono-cloud.com",
    "sshAuto": false,
    "sshHost": "",
    "group": "e-sueldos-v3"
  },
  "claude": {
    "binary": "claude",
    "liveUsage": true
  },
  "workday": {
    "entry": "",
    "exit": "",
    "punchUrl": ""
  },
  "repoServices": {
    "control-horario": "controlhorario",
    "file-manager": "files",
    "panel": "new-panel"
  },
  "checklists": {
    "test": [
      "Actualizar el ticket en Redmine",
      "Subir los comentarios"
    ],
    "daily": [
      "Marcar entrada",
      "Marcar salida",
      "Cargar horas"
    ]
  },
  "git": {
    "baseBranch": "desarrollo"
  },
  "checks": {
    "sharedSecret": {
      "key": "INTERNAL_SERVICE_SECRET",
      "repos": [
        "panel",
        "legajo",
        "cursos",
        "file-manager"
      ]
    },
    "firmaCaDir": "firma/src/modules/certificados/CA"
  },
  "testData": [
    {
      "db": "legajo",
      "collection": "legajodigitals",
      "field": "name"
    },
    {
      "db": "legajo",
      "collection": "tipolegajodigitals",
      "field": "name"
    },
    {
      "db": "documentos",
      "collection": "documentos",
      "field": "name"
    },
    {
      "db": "documentos",
      "collection": "carpetas",
      "field": "name"
    }
  ],
  "envProfiles": {
    "file-manager": {
      "file": ".env",
      "container": "files",
      "minio": [
        "AWS_ACCESS_KEY_ID=minioadmin",
        "AWS_SECRET_ACCESS_KEY=minioadmin",
        "AWS_S3_BUCKET_NAME=esueldos-s3",
        "AWS_ENDPOINT=http://minio:9000",
        "AWS_S3_PUBLIC_URL=http://localhost:9000",
        "AWS_S3_FORCE_PATH_STYLE=true",
        "USE_MINIO=true"
      ],
      "remote": [
        "AWS_S3_PUBLIC_URL!=http://localhost:9000",
        "AWS_S3_FORCE_PATH_STYLE!=true",
        "USE_MINIO=false"
      ]
    },
    "firma": {
      "file": ".env",
      "container": "firma",
      "minio": [
        "AWS_ACCESS_KEY_ID=minioadmin",
        "AWS_SECRET_ACCESS_KEY=minioadmin",
        "AWS_REGION=us-east-1",
        "AWS_S3_BUCKET_NAME=esueldos-s3",
        "AWS_ENDPOINT=http://minio:9000",
        "AWS_S3_PUBLIC_URL=http://localhost:9000",
        "AWS_S3_FORCE_PATH_STYLE=true",
        "USE_MINIO=true"
      ],
      "remote": []
    },
    "documentos": {
      "file": ".env",
      "container": "documentos",
      "minio": [
        "AWS_ACCESS_KEY_ID=minioadmin",
        "AWS_SECRET_ACCESS_KEY=minioadmin",
        "AWS_S3_BUCKET_NAME=esueldos-s3",
        "AWS_ENDPOINT=http://minio:9000",
        "AWS_S3_PUBLIC_URL=http://localhost:9000",
        "AWS_S3_FORCE_PATH_STYLE=true",
        "USE_MINIO=true"
      ],
      "remote": [
        "AWS_ACCESS_KEY_ID!=minioadmin",
        "AWS_SECRET_ACCESS_KEY!=minioadmin",
        "AWS_S3_BUCKET_NAME!=esueldos-s3",
        "AWS_S3_PUBLIC_URL!=http://localhost:9000",
        "AWS_S3_FORCE_PATH_STYLE!=true",
        "USE_MINIO=false"
      ]
    }
  },
  "startup": {
    "stage1": [
      "minio",
      "mc"
    ],
    "stage2": [
      "rabbitmq",
      "mongo-e-sueldos"
    ],
    "rabbitReady": {
      "container": "rabbitmq",
      "logMatch": "completed with 3 plugins",
      "timeoutSec": 180
    },
    "mandatory": [
      "new-panel",
      "security",
      "files",
      "legajo"
    ],
    "optional": [
      "leia",
      "firma",
      "controlhorario",
      "documentos",
      "cursos",
      "recibos",
      "incidencia",
      "notificaciones",
      "proyectos",
      "liquidacion",
      "recruiting",
      "salud-laboral",
      "help-center",
      "reconocimientoapi"
    ],
    "groups": {
      "leia": {
        "withStage2": [
          "leia-qdrant",
          "leia-redis"
        ]
      }
    },
    "presets": [
      {
        "name": "Solo obligatorios",
        "services": []
      },
      {
        "name": "Leia",
        "services": [
          "leia"
        ]
      }
    ]
  },
  "repos": [
    "documentos",
    "file-manager",
    "firma",
    "legajo",
    "front",
    "security"
  ]
}
